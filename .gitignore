# ── 환경변수 / 시크릿 ────────────────────────────────────────────────────────
# ※ .gitignore 는 같은 줄 주석(inline comment)을 지원하지 않는다. 주석은 반드시 별도 줄에.
.env
.env.*
.env.local
# Streamlit Cloud 시크릿 (절대 커밋 금지)
.streamlit/secrets.toml
# 방어적 와일드카드 (혹시 모를 시크릿 파일)
*secrets.toml
secrets.toml
*.pem
*.key

# ── AI CLI 도구 로컬 설정 (자격증명 포함 가능) ───────────────────────────────
.codex/
.gemini/
.claude/logs/
.claude/settings.local.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── 런타임 생성 데이터 (커밋 제외) ───────────────────────────────────────────
data/uploads/                # 사용자 업로드 임시 파일
data/graph.html              # pyvis 렌더링 결과물
# ※ data/*.csv, data/*.json, data/*.txt (데모 데이터)는 커밋 대상

# ── pyvis 번들 / pip 캐시 ────────────────────────────────────────────────────
lib/
pip/

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Node.js ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
