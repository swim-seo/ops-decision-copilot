# Anthropic Claude API Key
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase PostgreSQL (선택사항 — 없으면 CSV 모드로 동작)
# https://supabase.com 에서 프로젝트 생성 후 Settings → API에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# HuggingFace Inference API — ❌ 더 이상 필요 없음 (fastembed 로컬 전환).
# HF 가 serverless Inference API 를 중단해 로컬 ONNX(fastembed)로 교체함.
# 임베딩은 최초 1회 모델 다운로드 후 완전 로컬로 동작(키·네트워크 불필요).
# HUGGINGFACE_API_KEY=your_hf_api_key_here

# 인증 강제 여부 (Sprint 3 Step 2, 데모용 경량)
# - true : 유효 토큰 없는 요청을 401 로 거부(프로덕션).
# - 미설정(기본) : 데모 모드 — 토큰 있으면 검증해 신원 도출, 없으면 요청 파라미터 폴백.
# 검증은 Supabase GET /auth/v1/user 로 위임(JWT 시크릿 불필요).
# AUTH_REQUIRED=true

# 지식그래프 저장소 선택 (Sprint 2 영속성)
# - supabase : Supabase(JSONB blob)에 영속. 서버 재시작·멀티워커 안전.
#              사전조건: scripts/kg_persistence_migration.sql 실행(테이블 생성).
# - 미설정   : in-memory (개발 기본). 재시작 시 KG 소실(부트스트랩으로 보완).
# KG_STORE=supabase

# 데모 데이터 부트스트랩 (Sprint 1 Step 3)
# 서버 재시작 시 in-memory 지식그래프가 소실되는 문제 대응.
# 1/true 로 켜면 첫 요청 시 data/<sample>/ 에서 KG 를 결정적으로 재구축한다.
# supabase 스토어와 함께 쓰면: 행 부재 시 부트스트랩 후 DB 에 저장(멀티워커 수렴).
# 프로덕션에선 반드시 비워둘 것(데모 데이터 오염 방지). 기본: 비활성.
OPS_DEMO_BOOTSTRAP=1
# 기본 데모 collection 이 매핑될 샘플 디렉터리 (data/ 하위). 기본: beauty
OPS_DEMO_SAMPLE=beauty